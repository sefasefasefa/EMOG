{
  "$schema": "https://opencode.ai/config.json",

  "model": "devstral/local",

  "providers": {
    "devstral": {
      "name": "Devstral Small 2 24B Q4_K_M",
      "package": "@opencode/ai/providers/openai-compatible",

      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },

      "models": {
        "local": {
          "name": "Devstral Small 2 24B Q4_K_M",

          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },

          "limit": {
            "context": 8000,
            "output": 4096
          }
        }
      }
    }
  }
}
