# ============================================================
# EMOG - ORTAM DEGISKENLERI
# ============================================================
# Bu dosyayi .env olarak kopyalayin ve degerleri kendi anahtarlarinizla doldurun.
#
#   cp .env.example .env
#
# GUVENLIK KURALLARI:
#   1. API anahtarlari ve sirlar ASLA koda gomulmez
#   2. .env dosyasi .gitignore'dadir, ASLA commit edilmez
#   3. Uretimde zayif/ornek deger kullanilamaz (uygulama refuse-to-start yapar)
#   4. Anahtar uretme: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------- KRITIK (zorunlu) ----------
# Django imzalama anahtari: session, CSRF, JWT, parola turetme
# Uretimde 50+ karakter rastgele olmali
SECRET_KEY=

# Access token JWT imzalama anahtari
# SECRET_KEY'dan FARKLI olmasi onerilir
EMOG_JWT_SECRET=

# ---------- UYGULAMA ----------
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
PORT=8002
FRONTEND_URL=https://rodonsoft.me

# Canli preview QA (Playwright) icin yerel kimlik token'i.
# Bos birakilirsa uygulama baslangicinda otomatik uretilir.
PREVIEW_QA_TOKEN=

# Yetkili yonetici hesabi (admin paneline sadece bu hesap girer)
SUPERUSER_EMAIL=
ADMIN_URL=management-portal-v1/
# Virgulle ayirilmis kullanici adlari (bos ise SUPERUSER_EMAIL kullanilir)
ADMIN_ALLOWED_USERNAMES=

# ---------- AI MODELS ----------
USE_NVIDIA_API=true
NVIDIA_API_KEY=
# Bos birakilirsa en hizli model (NVIDIA_MODEL_TIERS icinde en yuksek 'speed') otomatik secilir.
# NVIDIA_DEFAULT_MODEL=nvidia/nemotron-nano-3-30b-a3b
# Isterseniz tier'lar disinda tek bir modeli sabitleyebilirsiniz:
# NVIDIA_FASTEST_TIER=lite
# NVIDIA_FASTEST_MODEL=nvidia/nemotron-nano-3-30b-a3b
# Saglayici yavas oldugunda istekler bu sure sonunda iptal edilir (saniye).
NVIDIA_TIMEOUT=120

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- VERITABANI / CACHE ----------
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# Cache: auto (db) | redis | memory
CACHE_BACKEND=auto
REDIS_URL=
REDIS_HOST=localhost

# ---------- AI BELLEK ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- E-POSTA (SMTP) ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---------- OAuth GIRIS ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- ENTEGRASYONLAR ----------
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
ADMIN_API_TOKEN=

# ---------- TOKEN YONETIMI ----------
# Kisa omurlu access token (dakika)
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token (gun)
REFRESH_TOKEN_TTL_DAYS=30
JWT_ALGORITHM=HS256

# ---------- GUVENLIK ----------
# 2FA zorunlulugu (admin paneli icin)
ADMIN_REQUIRE_OTP=false
# Istek baglantisi (parmak izi dogrulamasi)
REQUEST_BINDING_ENABLED=true
REQUEST_BINDING_STRICT_IP=false
REQUEST_BINDING_IP_GRACE_SECONDS=900
# CSRF double-submit
CSRF_BINDING_ENABLED=true
# Giris deneme siniri
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_LOCKOUT_SECONDS=600
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_DELAY_SECONDS=5
LOGIN_LIMIT_REGISTER=true
LOGIN_LIMIT_REFRESH=true

# ---------- ZERO TRUST ----------
VAULT_MASTER_KEY=

# ==========================================================================
# WEB ARAMA (derin arastirma + rakip analizi)
# ==========================================================================
# Bu anahtarlarin hicbiri zorunlu degildir. En az birini doldurursan arama
# kalitesi ve hiz artar; hicbiri yoksa sistem yine calisir:
#   ucretsiz saglayicilar: DuckDuckGo (HTML + Lite), Mojeek, Wikipedia,
#   GitHub, StackExchange, Hacker News, arXiv, Crossref, PubMed, Semantic Scholar
# Durumu gorebilmek icin: GET /build/providers/
SEARCH_LANG=tr
SEARCH_GL=tr
SEARCH_TIMEOUT=18
SEARCH_RESULTS_PER_QUERY=6
SEARCH_STACKEXCHANGE_SITE=stackoverflow

# --- Anahtarli saglayicilar (bos birakilirsa atlanir) ---
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_KEY=
EXA_API_KEY=
SERPAPI_KEY=
KAGI_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
YOU_API_KEY=
# Kendi SearXNG sunucun (anahtar gerektirmez ama adres gerekir)
SEARXNG_URL=

# --- Mevcut entegrasyonlardan gelen anahtarlar (varsa daha iyi sonuc) ---
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# ==========================================================================
# OTONOM PROJE URETIMI (buildkit)
# ==========================================================================
# "Haber sitesi yap", "3d oyun yap", "android forum sistemi yap" gibi
# istekler su donguden gecer:
#   arastirma -> rakip analizi -> spesifikasiyon -> plan -> uygulama -> elestiri
BUILD_PIPELINE_ENABLED=1
BUILD_MAX_ROUNDS=1000
BUILD_MAX_PLAN_ITEMS=500
BUILD_MIN_PLAN_ITEMS=32
BUILD_BLUEPRINT_MIN_FEATURES=30
BUILD_BLUEPRINT_MIN_GROUPS=8
BUILD_MAX_ITEM_ITERATIONS=500
BUILD_MAX_REPAIR_ATTEMPTS=100
BUILD_MAX_ITEM_RETRIES=200
BUILD_RETRY_BACKOFF_SECONDS=2
# Toplam sure butcesi (saniye). 0 = sinirsiz
BUILD_TIME_BUDGET=0
BUILD_CRITICAL_ERRORS=1000
BUILD_RESEARCH_QUERIES=12
BUILD_RESEARCH_PER_QUERY=6
BUILD_RESEARCH_DEEP_READS=12
BUILD_BENCHMARK_SITES=8
BUILD_CRITIC_GAP_ITEMS=8
# Execute/chat ajaninin maksimum arac-cagirma (LLM turu) sayisi
AGENT_MAX_ITERATIONS=5000
# Canli preview QA: build sonunda kac duzeltme turu denensin
BUILD_PREVIEW_QA_FIX_ROUNDS=100
WHATSAPP_SERVICE_URL=http://localhost:3002
WHATSAPP_SERVICE_TOKEN=
DJANGO_API_URL=http://127.0.0.1:8002
WHATSAPP_REMOTE_ENABLED=true
WHATSAPP_REMOTE_ALLOW_SELF_CHAT=true
# Kendi numaranız dışında komut gönderebilecek numaralar (virgülle, ülke koduyla)
WHATSAPP_REMOTE_ALLOWED_NUMBERS=
WHATSAPP_REMOTE_MAX_REPLY_CHARS=8000